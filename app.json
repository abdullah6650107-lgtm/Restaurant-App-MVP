{
  "expo": {
    "name": "RestaurantApp",
    "slug": "RestaurantApp",
    "scheme": "biteandbliss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.abdullah2390.restaurantapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withAndroidCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7EBD8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "839c599b-c679-4fdb-8954-4c872e3fc349"
      }
    }
  }
}
